    "def optimize_cpu():\n",
    "    # 1. Use ONLY physical cores to avoid context-switching overhead\n",
    "    # psutil.cpu_count(logical=False) gets the true physical cores\n",
    "    physical_cores = psutil.cpu_count(logical=False)\n",
    "    if physical_cores is None:\n",
    "        physical_cores = max(1, os.cpu_count() // 2)\n",
    "\n",
    "    # Conservative thread allocation to prevent throttling\n",
    "    num_threads = max(1, physical_cores - 1)  # Leave one core free for OS\n",
    "    torch.set_num_threads(num_threads)\n",
    "    torch.set_num_interop_threads(num_threads)\n",
    "\n",
    "    # 2. OpenMP and MKL optimizations capped at physical cores\n",
    "    os.environ[\"OMP_NUM_THREADS\"] = str(num_threads)\n",
    "    os.environ[\"MKL_NUM_THREADS\"] = str(num_threads)\n",
    "    \n",
    "    # 3. Disable debugging features that slow down CPU\n",
    "    torch.autograd.set_detect_anomaly(False)\n",
    "    torch.autograd.profiler.profile(enabled=False)\n",
    "    torch.autograd.profiler.emit_nvtx(enabled=False)\n",
    "\n",
    "\n",
    "optimize_cpu()"
   ]
