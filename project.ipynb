    "# 1. Convert logs to DataFrame\n",
    "df = pd.DataFrame(trainer.state.log_history)\n",
    "\n",
    "# 2. Extract specific columns\n",
    "# We use .dropna() to remove rows that don't have the specific metric we want\n",
    "train_df = df.dropna(subset=[\"loss\"])\n",
    "eval_df = df.dropna(subset=[\"eval_loss\"])\n",
    "\n",
    "# 3. Plotting\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "# Plot Training Loss\n",
    "plt.plot(train_df[\"step\"], train_df[\"loss\"], label=\"Train Loss\")\n",
    "\n",
    "# Plot Validation Loss (using 'epoch' as x-axis for eval)\n",
    "plt.plot(eval_df[\"step\"], eval_df[\"eval_loss\"], label=\"Val Loss\")\n",
    "\n",
    "\n",
    "\n",
    "plt.legend()\n",
    "plt.show()\n",
    "# 1. Get predictions \n",
    "y_pred = np.argmax(test_results.predictions, axis=1)\n",
    "\n",
    "# 2. Get true labels\n",
    "y_true = test_results.label_ids\n",
    "\n",
    "# 3. Define class names \n",
    "class_names = [\"World\", \"Sports\", \"Business\", \"Sci/Tech\"]\n",
    "\n",
    "# 4. Instantiate and run evaluator\n",
    "evaluator = ModelEvaluator(y_true, y_pred, class_names=class_names)\n",
    "\n",
    "# 5. Execute all analysis\n",
    "evaluator.show_report()\n",
    "evaluator.plot_confusion_matrix()\n",
    "evaluator.plot_f1_scores()\n",
    "evaluator.save_errors(test['text'], filename=\"DistilBERT_errors.csv\")\n"
