    "# Assuming you have 'preds' from trainer.predict(test_dataset)\n",
    "import numpy as np\n",
    "import torch\n",
    "# Get predictions and probabilities\n",
    "probs = torch.nn.functional.softmax(torch.tensor(test_results.predictions), dim=-1)\n",
    "max_probs, pred_indices = torch.max(probs, dim=-1)\n",
    "labels = test_dataset[\"labels\"]  # Ensure this matches your column name\n",
    "\n",
    "\n",
    "# 1. Convert pred_indices to numpy (you already have pred_indices from your previous code)\n",
    "pred_indices_np = pred_indices.detach().cpu().numpy()\n",
    "\n",
    "# 2. Ensure labels is a clean numpy array (handles tensors or lists)\n",
    "labels_np = np.array(labels) if not isinstance(labels, np.ndarray) else labels\n",
    "\n",
    "# 3. Apply the mask and calculate\n",
    "high_conf_mask = max_probs.detach().cpu().numpy() >= 0.85\n",
    "high_conf_indices = np.where(high_conf_mask)[0]\n",
    "\n",
    "# Extract subsets\n",
    "pred_subset = pred_indices_np[high_conf_indices]\n",
    "label_subset = labels_np[high_conf_indices]\n",
    "\n",
    "# Compare\n",
    "correct_high_conf = np.sum(pred_subset == label_subset)\n",
    "wrong_high_conf = np.sum(pred_subset != label_subset)\n",
    "\n",
    "print(f\"High Confidence Predictions (>= 0.85): {len(high_conf_indices)}\")\n",
    "print(f\" - Correct: {correct_high_conf}\")\n",
    "print(f\" - WRONG: {wrong_high_conf}\")\n"
   ]
