    "    # Copy and transform\n",
    "    train_ds = Dataset.from_pandas(\n",
    "        train_df.assign(**{\"Class Index\": train_df[\"Class Index\"] })\n",
    "    )\n",
    "    test_ds = Dataset.from_pandas(\n",
    "        test_df.assign(**{\"Class Index\": test_df[\"Class Index\"] })\n",
    "    )\n",
    "\n",
    "    # Split\n",
    "    split = train_ds.train_test_split(test_size=0.2)\n",
    "    train_ds, val_ds = split[\"train\"], split[\"test\"]\n",
    "\n",
    "    # Tokenize\n",
    "    def tokenize_fn(batch):\n",
    "        return tokenizer(\n",
    "            batch[\"text\"], max_length=64, truncation=True, padding=\"max_length\"\n",
    "        )\n",
    "\n",
    "    cols = [\"input_ids\", \"attention_mask\", \"labels\"]\n",
    "    datasets = [\n",
    "        d.map(tokenize_fn, batched=True)\n",
    "        .rename_column(\"Class Index\", \"labels\")\n",
    "        .with_format(\"torch\", columns=cols)\n",
    "        for d in [train_ds, val_ds, test_ds]\n",
    "    ]\n",
    "\n",
    "    return datasets[0], datasets[1], datasets[2]\n"
   ]
  },
