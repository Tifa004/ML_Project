    "results = pd.read_csv(\"benchmark_results.csv\")\n",
    "# Returns a new dataframe excluding all LSTM rows\n",
    "df = results[results[\"Model\"] != \"LSTM\"]\n",
    "\n",
    "set_seed(42)\n",
    "\n",
    "\n",
    "def run_benchmark():\n",
    "    percentages = [0.01, 0.1, 0.5, 1.0]\n",
    "    models = [ \"LSTM\"]\n",
    "    results = []\n",
    "\n",
    "    for p in percentages:\n",
    "        print(\"\\n\" + \"=\" * 60)\n",
    "        print(f\"--- Running experiments for {p * 100}% data size ---\")\n",
    "\n",
    "        train_subset = get_train_subset(train, p)\n",
    "\n",
    "        for model_name in models:\n",
    "            set_seed(42)  # Reset seed for each experiment to ensure reproducibility\n",
    "\n",
    "            print(f\"\\n>>> [{model_name}] starting — data size: {p * 100:.0f}%\")\n",
    "            print(\"-\" * 60)\n",
    "            torch.cuda.empty_cache()\n",
    "            model_size, train_time, test_acc = run_experiment(\n",
    "                model_name, train_subset, test, p\n",
    "            )\n",
    "\n",
    "            # Log Results\n",
    "            results.append(\n",
    "                {\n",
    "                    \"Model\": model_name,\n",
    "                    \"Data Size (%)\": p * 100,\n",
    "                    \"Accuracy\": test_acc,\n",
    "                    \"Time (s)\": train_time,\n",
    "                    \"Model Size\": model_size,\n",
    "                }\n",
    "            )\n",
    "            print(\n",
    "                f\"Finished {model_name}: {test_acc:.4f} accuracy in {train_time:.1f}s\"\n",
    "            )\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "df_lstm = run_benchmark()\n",
    "df=pd.concat([df, df_lstm], ignore_index=True)\n",
    "df.to_csv(\"benchmark_results.csv\", index=False)\n",
    "plot_acc_dataSize(df)\n",
