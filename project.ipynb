    "\n",
    "\n",
    "def run_lstm_training(train_loader, val_loader, test_loader, params):\n",
    "    model = LSTM(**params).to(device)\n",
    "    optimizer = optim.Adam(model.parameters(), lr=0.001)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    history = {\"train_loss\": [], \"val_loss\": []}\n",
    "    scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer,\n",
    "        mode=\"min\",\n",
    "        factor=0.1,\n",
    "        patience=2,\n",
    "    )\n",
    "    best_val_loss = float(\"inf\")\n",
    "    passes = 10\n",
    "\n",
    "    print(\n",
    "        f\"{'Epoch':<8} | {'Train Loss':<12} | {'Val Loss':<12} | {'Val Acc':<10} | {'Status':<10}\"\n",
    "    )\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    history = TrainingHistory()\n",
    "\n",
    "    for p in range(passes):\n",
    "        # 1. Training Phase\n",
    "        train_loss, train_acc = train_model(model, train_loader, criterion, optimizer, device)\n",
    "\n",
    "        # 2. Validation Phase\n",
    "        val_loss, val_acc = evaluate_model(model, val_loader, criterion, device)\n",
    "\n",
    "        scheduler.step(val_loss)\n",
    "        # 3. Saving the Best Model\n",
    "        status = \"\"\n",
    "        if val_loss < best_val_loss:\n",
    "            best_val_loss = val_loss\n",
    "            torch.save(model.state_dict(), \"best_model.pth\")\n",
    "            status = \"SAVED\"\n",
    "        history.update(train_loss,train_acc,val_loss,val_acc)\n",
    "        print(\n",
    "            f\"{p + 1:<8} | {train_loss:<12.4f} | {val_loss:<12.4f} | {val_acc * 100:<9.2f}% | {status:<10}\"\n",
    "        )\n",
    "\n",
    "    # --- FINAL EVALUATION ---\n",
    "    print(\"\\n\" + \"=\" * 40)\n",
    "    print(\"Training Complete. Loading Best Model...\")\n",
    "    print(\"=\" * 40)\n",
    "\n",
    "    # Load the weights from the best-performing epoch\n",
    "    model.load_state_dict(torch.load(\"best_model.pth\"))\n",
    "\n",
    "    # Run final test\n",
    "    test_loss, test_acc = evaluate_model(model, test_loader, criterion, device)\n",
    "\n",
    "    print(f\"Final Test Accuracy: {test_acc * 100:.2f}%\")\n",
    "    history.plot()\n",
    "\n",
    "    return model\n"
   ]
  },
