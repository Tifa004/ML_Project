    "import evaluate\n",
    "from transformers import (\n",
    "    Trainer,\n",
    "    TrainingArguments,\n",
    "    AutoModelForSequenceClassification,\n",
    "    EarlyStoppingCallback,\n",
    ")\n",
    "\n",
    "# 1. Define how to calculate accuracy\n",
    "metric = evaluate.load(\"f1\")\n",
    "\n",
    "\n",
    "def compute_metrics(eval_pred):\n",
    "    logits, labels = eval_pred\n",
    "    predictions = np.argmax(logits, axis=-1)\n",
    "    return metric.compute(predictions=predictions, references=labels,average='weighted')\n",
    "\n",
    "\n",
    "# 2. Configure the Trainer\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./results\",\n",
    "    learning_rate=2e-5,  # Standard for fine-tuning BERT\n",
    "    per_device_train_batch_size=32,\n",
    "    per_device_eval_batch_size=32,\n",
    "    num_train_epochs=10,  \n",
    "    weight_decay=0.01,  # Helps prevent overfitting\n",
    "    eval_strategy=\"epoch\",  # Evaluates every epoch\n",
    "    save_strategy=\"epoch\",\n",
    "    load_best_model_at_end=True,  # Automatically saves the best model\n",
    "    label_smoothing_factor=0.2\n",
    ")\n",
    "\n",
    "# 3. Initialize Trainer\n",
    "model = AutoModelForSequenceClassification.from_pretrained(\n",
    "    \"distilbert-base-uncased\", num_labels=4\n",
    ").to(device)\n",
    "\n",
    "# 'early_stopping_patience=x' means: \"Stop if the validation loss\n",
    "# doesn't improve for x evaluation rounds (epochs).\"\n",
    "early_stop = EarlyStoppingCallback(early_stopping_patience=1)\n",
    "\n",
    "trainer = Trainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=train_dataset,\n",
    "    eval_dataset=val_dataset,\n",
    "    compute_metrics=compute_metrics,\n",
    "    callbacks=[early_stop],\n",
    ")\n",
    "\n",
    "# 4. Train\n",
    "trainer.train()\n",
    "\n",
    "# 5 Test\n",
    "test_results = trainer.predict(test_dataset)\n"
   ]
  },
