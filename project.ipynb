    "\n",
    "        # Filter for errors\n",
    "        errors = df[df[\"actual_idx\"] != df[\"predicted_idx\"]].copy()\n",
    "\n",
    "        # Map indices to names if possible\n",
    "        if self.class_names:\n",
    "            errors[\"actual_label\"] = [self._get_label_name(i) for i in errors[\"actual_idx\"]]\n",
    "            errors[\"predicted_label\"] = [self._get_label_name(i) for i in errors[\"predicted_idx\"]]\n",
