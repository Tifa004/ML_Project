    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "\n",
    "def get_final_metrics(trainer, train_ds, val_ds):\n",
    "    # Predict on both sets\n",
    "    train_preds = trainer.predict(train_ds)\n",
    "    val_preds = trainer.predict(val_ds)\n",
    "\n",
    "    # Calculate accuracy\n",
    "    train_acc = accuracy_score(\n",
    "        train_ds[\"labels\"], np.argmax(train_preds.predictions, axis=-1)\n",
    "    )\n",
    "    val_acc = accuracy_score(\n",
    "        val_ds[\"labels\"], np.argmax(val_preds.predictions, axis=-1)\n",
    "    )\n",
    "\n",
    "    return train_acc, val_acc\n",
    "\n",
    "\n",
    "final_train_acc, final_val_acc = get_final_metrics(trainer, train_dataset, val_dataset)\n",
    "\n",
    "print(f\"Final Training Accuracy: {final_train_acc*100:.2f}\")\n",
    "print(f\"Final Validation Accuracy: {final_val_acc*100:.2f}\")\n"
   ]
