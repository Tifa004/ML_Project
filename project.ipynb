    "def clean_text(text):\n",
    "    # 1. Unescape HTML entities (e.g., \"&#39;\" -> \"'\", \"&lt;\" -> \"<\")\n",
    "    text = html.unescape(text)\n",
    "    # 2. Remove actual HTML tags (e.g., \"<b>...</b>\")\n",
    "    text = re.sub(r\"<[^>]+>\", \"\", text)\n",
    "    # 3. Clean up excessive whitespace\n",
    "    text = \" \".join(text.split())\n",
    "    return text\n",
    "\n",
    "def get_train_subset(train_df, percentage, random_state=42):\n",
    "\n",
    "    # Calculate exactly how many rows we need\n",
    "    n_samples = int(len(train_df) * percentage)\n",
    "\n",
    "    # Take the sample and reset index\n",
    "    subset = train_df.sample(n=n_samples, random_state=random_state).reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    "    return subset\n",
    "\n",
    "# Shift labels from 1-4 to 0-3 (CrossEntropyLoss requires 0-indexed labels)\n",
    "train[\"Class Index\"] = train[\"Class Index\"] - 1\n",
    "test[\"Class Index\"]  = test[\"Class Index\"]  - 1\n",
    "\n",
    "# Combine Title and Description into a single 'text' column\n",
    "train[\"text\"] = train[\"Title\"] + \" \" + train[\"Description\"]\n",
    "test[\"text\"]  = test[\"Title\"]  + \" \" + test[\"Description\"]\n",
    "\n",
    "# Apply HTML cleaning to both sets\n",
    "train[\"text\"] = train[\"text\"].apply(clean_text)\n",
    "test[\"text\"]  = test[\"text\"].apply(clean_text)\n",
    "\n",
    "# Keep only the columns we need\n",
    "train = train[[\"Class Index\", \"text\"]]\n",
    "test  = test[[\"Class Index\", \"text\"]]\n",
    "\n",
    "# Shuffle to remove ordering bias\n",
    "train = train.sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "test  = test.sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "\n",
    "print(train.head())\n"
   ]
