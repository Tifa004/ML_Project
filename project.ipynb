    "                \"Predicted Class\": errors[\"predicted_label\"],\n",
    "            }\n",
    "        )\n",
    "        filepath=os.path.join(\"errors\", modelname, filename)\n",
    "        final_errors.to_csv(filepath, index=False)\n",
    "        print(f\"Success: {len(errors)} errors saved to '{filename}'\")\n",
