    "from datasets import Dataset\n",
    "from torch.utils.data import DataLoader, random_split\n",
    "from transformers import DistilBertTokenizer\n",
    "import re\n",
    "import html\n",
    "tokenizer = DistilBertTokenizer.from_pretrained(\"distilbert-base-uncased\")\n",
    "\n",
    "train2 = train.copy()\n",
    "test2 = test.copy()\n",
    "\n",
    "# Perform transformation on the copies\n",
    "train2[\"Class Index\"] = train2[\"Class Index\"] - 1\n",
    "test2[\"Class Index\"] = test2[\"Class Index\"] - 1\n",
    "print(\"Min label:\", train2[\"Class Index\"].min())\n",
    "print(\"Max label:\", train2[\"Class Index\"].max())\n",
    "train_dataset = Dataset.from_pandas(train2)\n",
    "test_dataset = Dataset.from_pandas(test2)\n",
    "\n",
    "# 3. Define split sizes\n",
    "train_size = int(0.8 * len(train_dataset))\n",
    "val_size = len(train_dataset) - train_size\n",
    "\n",
    "# 4. Perform the split\n",
    "split_data = train_dataset.train_test_split(test_size=0.2)\n",
    "train_dataset=split_data['train']\n",
    "val_dataset=split_data['test']\n",
    "\n",
    "def tokenize_fn(batch):\n",
    "    return tokenizer(\n",
    "        batch[\"text\"], max_length=64, truncation=True, padding=\"max_length\"\n",
    "    )\n",
    "\n",
    "def clean_text(text):\n",
    "    # 1. Unescape HTML entities (e.g., \"&#39;\" -> \"'\", \"&lt;\" -> \"<\")\n",
    "    text = html.unescape(text)\n",
    "    # 2. Remove actual HTML tags (e.g., \"<b>...</b>\")\n",
    "    text = re.sub(r\"<[^>]+>\", \"\", text)\n",
    "    # 3. Clean up excessive whitespace\n",
    "    text = \" \".join(text.split())\n",
    "    return text\n",
    "\n",
    "# Apply to all datasets\n",
    "train_dataset = train_dataset.map(tokenize_fn, batched=True, batch_size=1000)\n",
    "val_dataset = val_dataset.map(tokenize_fn, batched=True, batch_size=1000)\n",
    "test_dataset = test_dataset.map(tokenize_fn, batched=True, batch_size=1000)\n",
    "\n",
    "# Cleanup\n",
    "train_dataset = train_dataset.rename_column(\"Class Index\", \"labels\")\n",
    "val_dataset = val_dataset.rename_column(\"Class Index\", \"labels\")\n",
    "test_dataset = test_dataset.rename_column(\"Class Index\", \"labels\")\n",
    "\n",
    "train_dataset = train_dataset.map(lambda x: {\"text\": clean_text(x[\"text\"])})\n",
    "val_dataset = val_dataset.map(lambda x: {\"text\": clean_text(x[\"text\"])})\n",
    "test_dataset = test_dataset.map(lambda x: {\"text\": clean_text(x[\"text\"])})\n",
    "\n",
    "# Set the format for PyTorch\n",
    "train_dataset.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
    "val_dataset.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
    "test_dataset.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
    "\n",
