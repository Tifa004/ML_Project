    "def run_experiment(model_type, train_df, test_df, model_params=None):\n",
    "    print(f\"--- Starting {model_type} Experiment ---\")\n",
    "\n",
    "    preds=None\n",
    "    true_labels=None\n",
    "    history=None\n",
    "    # 1. DATA PREPARATION (Strategy-specific)\n",
    "    if model_type == \"TF-IDF\":\n",
    "        # TF-IDF doesn't need loaders\n",
    "        data = (train_df, test_df)\n",
    "\n",
    "    elif model_type == \"LSTM\":\n",
    "        # LSTM needs loaders\n",
    "        train_loader, val_loader, test_loader = prepare_lstm_loaders(train_df, test_df)\n",
    "        data = (train_loader, val_loader, test_loader)\n",
    "    elif model_type == \"DistilBERT\":\n",
    "        train_ds, val_ds, test_ds = prepare_distilbert_data(train_df, test_df)\n",
    "        trainer = run_distilbert_training(train_ds, val_ds)\n",
    "        res = trainer.predict(test_ds)\n",
    "        preds = np.argmax(res.predictions, axis=1)\n",
    "        true_labels = res.label_ids\n",
    "        \n",
    "    # 2. TRAINING (Strategy-specific)\n",
    "    if model_type == \"TF-IDF\":\n",
    "        model = run_tfidf_training(train_df,test_df)\n",
    "        preds = model.predict(test_df[\"text\"])\n",
    "        true_labels = test_df[\"Class Index\"]\n",
    "\n",
    "    elif model_type == \"LSTM\":\n",
    "        model, history = run_lstm_training(data[0], data[1], data[2], model_params)\n",
    "        # Get predictions from helper function\n",
    "        true_labels, preds = get_lstm_predictions(model, test_loader, device)\n",
    "\n",
    "\n",
    "    # EVALUATION & PLOTTING\n",
    "    plot_evaluation(model_type,preds, true_labels,test_df['text'], history,)\n",
    "\n",
    "\n",
    "def plot_evaluation(model_name,y_pred, y_true, test_texts, history):\n",
    "    evaluator = ModelEvaluator(\n",
    "        y_true=y_true,\n",
    "        y_pred=y_pred,\n",
    "        class_names=[\"World\", \"Sports\", \"Business\", \"Sci/Tech\"],\n",
    "    )\n",
    "    \n",
    "    print(f\"--- Generating Report for {model_name} ---\")\n",
    "    evaluator.show_report()\n",
    "    evaluator.plot_confusion_matrix()\n",
    "    evaluator.plot_f1_scores()\n",
    "    evaluator.save_errors(texts=test_texts, filename=f\"{model_name}_errors.csv\")\n",
    "    \n"
   ]
