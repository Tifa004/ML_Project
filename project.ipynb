    "def set_seed(seed: int):\n",
    "    \"\"\"\n",
    "        Sets the random seed for reproducibility\n",
    "        \"\"\"\n",
    "    # 1. Python's built-in random module\n",
    "    random.seed(seed)\n",
    "\n",
    "    # 2. NumPy for array operations\n",
    "    np.random.seed(seed)\n",
    "\n",
    "    # 3. PyTorch general seeds\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)  # For multi-GPU setups\n",
    "\n",
    "    # 4. CuDNN settings for strict reproducibility\n",
    "    # 'deterministic = True' forces the GPU to use deterministic algorithms.\n",
    "    # 'benchmark = False' prevents the GPU from finding the \"optimal\" algorithm\n",
    "    # for hardware, which can vary from run to run.\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "    torch.backends.cudnn.benchmark = False\n",
    "\n",
    "    # 5. Environment variable for Python hash randomization\n",
    "    # Ensures consistency in dictionary/set operations (important for vocabularies)\n",
    "    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n",
    "\n"
   ]
