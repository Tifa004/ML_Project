    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# 1. Get predictions from the trainer\n",
    "# trainer.predict returns a PredictionOutput object\n",
    "predictions_output = trainer.predict(test_dataset)\n",
    "\n",
    "# 2. Convert logits to probabilities using Softmax\n",
    "logits = torch.tensor(predictions_output.predictions)\n",
    "probs = F.softmax(logits, dim=-1)\n",
    "\n",
    "# 3. Get the maximum probability for each prediction (the \"Confidence Score\")\n",
    "max_probs, _ = torch.max(probs, dim=-1)\n",
    "\n",
